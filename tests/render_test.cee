// SPDX-License-Identifier: MIT
// Pages drawn to pixels against CosmoReport's ImageExport (with the fixes on CosmoPdf's fix/image-export-text
// branch): tests/expected/images/X*.png, written by `dotnet RefDump.dll image tests/fixtures/X.frx ... [notext]`.
// Every pixel is compared. A page that differs is written to out/X.png beside a count of what differs and where.
import claywind;

fn emptyTexts(objects: borrow mut Vector<Component>) {
    for (j in 0..objects.length) {
        let o = borrow mut objects[j];
        match (borrow mut o.text) {
            Some(t) => { t.processed = String.create(); }
            null => {}
        }
        for (r in 0..o.tableRows.length) {
            emptyTexts(mut o.tableRows[r].cells);
        }
    }
}

fn preparedOf(file: StringView, sourceName: StringView, dataFile: StringView, report: borrow Report)
    -> Result<Vector<PreparedPage>, TestFailure> {
    var path = String.create();
    let _ = path.append("tests/fixtures/");
    let _ = path.append(file);
    let _ = path.append(".frx");
    let root = match (parseXml(readFile(path.view()).view())) {
        Ok(r) => r,
        Err(_) => { return Err(TestFailure.create("the report is not XML")); }
    };
    var data = DataSet.create(Schema.read(root));
    match (data.register(sourceName, readFile(dataFile).view())) {
        Ok() => {}
        Err(_) => { return Err(TestFailure.create("the data did not read")); }
    }
    var handlers = Handlers.create();
    handlers.add("Data1_BeforePrint", shadeOddRows);
    return Ok(if (file == "PosInvoice") preparePages(report, data, Handlers.create(), NewlinesOnly.create())
        else preparePages(report, data, handlers, NewlinesOnly.create()));
}

/// Canvas `got` against the PNG at `expected`: their sizes, then every pixel's red (the pages are black and white).
fn samePixels(got: borrow Canvas, expected: StringView, name: StringView) -> Result<void, TestFailure> {
    let png = readFile(expected);
    let info = match (imageInfo(png.view())) {
        Ok(i) => i,
        Err(_) => { return Err(TestFailure.create("the expected image does not decode")); }
    };
    var pixels = Vector<u32>.create();
    for (k in 0..info.w * info.h) {
        let _ = pixels.push(0);
    }
    var scratch = Vector<u8>.create();
    for (k in 0..info.scratchBytes) {
        let _ = scratch.push(0);
    }
    match (decodeImage(png.view(), pixels.viewMut(), scratch.viewMut())) {
        Ok(_) => {}
        Err(_) => { return Err(TestFailure.create("the expected image does not decode")); }
    }
    var differ: i64 = 0;
    var firstX: i64 = -1;
    var firstY: i64 = -1;
    let sameSize = truncate<i64>(info.w) == got.width && truncate<i64>(info.h) == got.height;
    if (sameSize) {
        for (y in 0..got.height) {
            for (x in 0..got.width) {
                let want = truncate<u8>(pixels[truncate<usize>(y * got.width + x)] & 0xFF);
                let have = got.rgb[truncate<usize>((y * got.width + x) * 3)];
                if (want != have) {
                    if (differ == 0) {
                        firstX = x;
                        firstY = y;
                    }
                    differ += 1;
                }
            }
        }
    }
    if (sameSize && differ == 0) {
        return Ok();
    }
    var out = String.create();
    let _ = out.append("out/");
    let _ = out.append(name);
    let _ = out.append(".png");
    match (File.create(out.view())) {
        Ok(f) => {
            var file = f;
            let bytes = got.png();
            let _ = file.write(bytes.view());
        }
        Err(_) => {}
    }
    Console.write("  want ");
    Console.write(truncate<i64>(info.w));
    Console.write("x");
    Console.write(truncate<i64>(info.h));
    Console.write(", got ");
    Console.write(got.width);
    Console.write("x");
    Console.writeLine(got.height);
    Console.write("  pixels that differ: ");
    Console.write(differ);
    Console.write(", the first at ");
    Console.write(firstX);
    Console.write(",");
    Console.writeLine(firstY);
    return Err(TestFailure.create("the page is not CosmoReport's"));
}

fn heapBytes(n: usize) -> Vector<u8> {
    var v = Vector<u8>.create();
    for (k in 0..n) {
        let _ = v.push(0);
    }
    return v;
}

/// The macOS faces CosmoReport finds for the reports' families (FontBridge: /System/Library/Fonts/Supplemental).
fn addSystemFonts(fonts: borrow mut Fonts) -> bool {
    let dir = "/System/Library/Fonts/Supplemental/";
    let names: [StringView; 4] = ["Arial.ttf", "Arial Bold.ttf", "Tahoma.ttf", "Tahoma Bold.ttf"];
    let families: [StringView; 4] = ["Arial", "Arial", "Tahoma", "Tahoma"];
    let bold: [bool; 4] = [false, true, false, true];
    for (k in 0..4usize) {
        var path = copyOf(dir);
        let _ = path.append(names[k]);
        let bytes = readFile(path.view());
        if (bytes.length == 0 || !fonts.add(families[k], bold[k], false, bytes)) {
            return false;
        }
    }
    return true;
}

fn samePagesWithoutText(file: StringView, sourceName: StringView) -> Result<void, TestFailure> {
    var path = String.create();
    let _ = path.append("tests/fixtures/");
    let _ = path.append(file);
    let _ = path.append(".frx");
    let report = match (loadReport(readFile(path.view()).view())) {
        Ok(r) => r,
        Err(_) => { return Err(TestFailure.create("the report did not load")); }
    };
    var pages = preparedOf(file, sourceName, "tests/data/invoice.json", report)?;
    for (p in 0..pages.length) {
        for (b in 0..pages[p].bands.length) {
            emptyTexts(mut pages[p].bands[b].band.children);
        }
    }
    var storage = heapBytes(16777216);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var capacity = RasterCapacity.of(1, 1);
    capacity.fontBytes = 1048576;
    let raster = Raster.create(memory, capacity)!;
    let fonts = Fonts.over(raster);
    let canvases = renderPages(report, pages, fonts, RenderOptions.receipt());
    var expected = String.create();
    let _ = expected.append("tests/expected/images/");
    let _ = expected.append(file);
    let _ = expected.append(".notext-1.png");
    var name = copyOf(file);
    let _ = name.append(".notext");
    return samePixels(canvases[0], expected.view(), name.view());
}

@test
fn thePosInvoiceWithoutTextIsCosmoReportsPixels() -> Result<void, TestFailure> =>
    samePagesWithoutText("PosInvoice", "Header");

@test
fn theMyInvoiceWithoutTextIsCosmoReportsPixels() -> Result<void, TestFailure> =>
    samePagesWithoutText("MyInvoice", "Invoice");

@test
fn theServersMyInvoiceWithoutTextIsCosmoReportsPixels() -> Result<void, TestFailure> =>
    samePagesWithoutText("MyInvoice.server", "Invoice");

/// A page written as PNG reads back as the same pixels (claywind's decoder), and is written to out/ for other readers.
@test
fn aPageWrittenAsPngReadsBack() -> Result<void, TestFailure> {
    let report = match (loadReport(readFile("tests/fixtures/MyInvoice.server.frx").view())) {
        Ok(r) => r,
        Err(_) => { return Err(TestFailure.create("the report did not load")); }
    };
    let pages = preparedOf("MyInvoice.server", "Invoice", "tests/data/invoice.json", report)?;
    var storage = heapBytes(16777216);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    let raster = Raster.create(memory, RasterCapacity.of(1, 1))!;
    let fonts = Fonts.over(raster);
    let canvases = renderPages(report, pages, fonts, RenderOptions.receipt());
    let png = canvases[0].png();
    match (File.create("out/roundtrip.png")) {
        Ok(f) => {
            var file = f;
            let _ = file.write(png.view());
        }
        Err(_) => {}
    }
    let info = match (imageInfo(png.view())) {
        Ok(i) => i,
        Err(_) => { return Err(TestFailure.create("the PNG does not read")); }
    };
    var pixels = Vector<u32>.create();
    for (k in 0..info.w * info.h) {
        let _ = pixels.push(0);
    }
    var scratch = Vector<u8>.create();
    for (k in 0..info.scratchBytes) {
        let _ = scratch.push(0);
    }
    match (decodeImage(png.view(), pixels.viewMut(), scratch.viewMut())) {
        Ok(_) => {}
        Err(_) => { return Err(TestFailure.create("the PNG does not decode")); }
    }
    let c = borrow canvases[0];
    for (k in 0..info.w * info.h) {
        let p = pixels[k];
        if (truncate<u8>(p & 0xFF) != c.rgb[k * 3] || truncate<u8>((p >> 8) & 0xFF) != c.rgb[k * 3 + 1] ||
            truncate<u8>((p >> 16) & 0xFF) != c.rgb[k * 3 + 2]) {
            return Err(TestFailure.create("a pixel read back differs"));
        }
    }
    Check.isTrue(png.length < c.rgb.length / 10, "the page compresses")?;
    return Ok();
}

/// Every page of a report with its text, drawn with the system's Arial and Tahoma, against CosmoReport's.
fn samePagePixels(file: StringView, sourceName: StringView, dataFile: StringView, expectedStem: StringView)
    -> Result<void, TestFailure> {
    var path = String.create();
    let _ = path.append("tests/fixtures/");
    let _ = path.append(file);
    let _ = path.append(".frx");
    let report = match (loadReport(readFile(path.view()).view())) {
        Ok(r) => r,
        Err(_) => { return Err(TestFailure.create("the report did not load")); }
    };
    let pages = preparedOf(file, sourceName, dataFile, report)?;
    var storage = heapBytes(67108864);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var capacity = RasterCapacity.of(1, 1);
    capacity.fontBytes = 8388608;
    let raster = Raster.create(memory, capacity)!;
    var fonts = Fonts.over(raster);
    if (!addSystemFonts(mut fonts)) {
        Console.writeLine("  (Arial or Tahoma not found: skipped)");
        return Ok();
    }
    let canvases = renderPages(report, pages, fonts, RenderOptions.receipt());
    for (k in 0..canvases.length) {
        var expected = String.create();
        let _ = expected.append("tests/expected/images/");
        let _ = expected.append(expectedStem);
        let _ = expected.append("-");
        appendInt(mut expected, truncate<i64>(k) + 1);
        let _ = expected.append(".png");
        var name = copyOf(expectedStem);
        let _ = name.append("-");
        appendInt(mut name, truncate<i64>(k) + 1);
        samePixels(canvases[k], expected.view(), name.view())?;
    }
    return Ok();
}

@test
fn thePosInvoiceIsCosmoReportsPixels() -> Result<void, TestFailure> =>
    samePagePixels("PosInvoice", "Header", "tests/data/invoice.json", "PosInvoice");

@test
fn theServersMyInvoiceIsCosmoReportsPixels() -> Result<void, TestFailure> =>
    samePagePixels("MyInvoice.server", "Invoice", "tests/data/invoice.json", "MyInvoice.server");

@test
fn theMyInvoiceIsCosmoReportsPixels() -> Result<void, TestFailure> =>
    samePagePixels("MyInvoice", "Invoice", "tests/data/invoice.json", "MyInvoice");

@test
fn aLongReceiptIsCosmoReportsPixels() -> Result<void, TestFailure> =>
    samePagePixels("PosInvoice", "Header", "tests/data/invoice45.json", "PosInvoice.45");

@test
fn aLongMyInvoiceIsCosmoReportsPixelsOnEveryPage() -> Result<void, TestFailure> =>
    samePagePixels("MyInvoice", "Invoice", "tests/data/invoice45.json", "MyInvoice.45");

@test
fn aLongServersMyInvoiceIsCosmoReportsPixelsOnEveryPage() -> Result<void, TestFailure> =>
    samePagePixels("MyInvoice.server", "Invoice", "tests/data/invoice45.json", "MyInvoice.server.45");

/// On paper, a band is where the engine put it: the server's MyInvoice's group footer (printed at the bottom) and
/// its QR code at the page's foot, not after the lines as ImageExport packs them; the page as tall as A4.
@test
fn onPaperTheFooterStaysAtThePagesFoot() -> Result<void, TestFailure> {
    let report = match (loadReport(readFile("tests/fixtures/MyInvoice.server.frx").view())) {
        Ok(r) => r,
        Err(_) => { return Err(TestFailure.create("the report did not load")); }
    };
    let pages = preparedOf("MyInvoice.server", "Invoice", "tests/data/invoice.json", report)?;
    var storage = heapBytes(16777216);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    let raster = Raster.create(memory, RasterCapacity.of(1, 1))!;
    let fonts = Fonts.over(raster);
    let dpi: i64 = 96;
    let canvases = renderPages(report, pages, fonts, RenderOptions.paper(dpi));
    let c = borrow canvases[0];
    Check.equalU64(truncate<u64>(roundEven(297.0 * 96.0 / 25.4)), truncate<u64>(c.height))?;
    // The group footer's barcode: its box on the page, from the engine's place for the footer.
    var found = false;
    for (b in pages[0].bands.view()) {
        if (b.band.kind != Kind.GroupFooterBand) {
            continue;
        }
        for (o in b.band.children.view()) {
            if (o.kind != Kind.BarcodeObject) {
                continue;
            }
            found = true;
            let page = borrow report.pages[0];
            let x = roundEven((page.leftMargin as f64) * 96.0 / 25.4 + ((b.band.left + o.left) as f64));
            let y = roundEven((page.topMargin as f64) * 96.0 / 25.4 + ((b.band.top + o.top) as f64));
            Check.isTrue(y > c.height / 2, "the footer is in the page's lower half")?;
            var dark: i64 = 0;
            var light: i64 = 0;
            for (yy in y..y + truncate<i64>(o.height)) {
                for (xx in x..x + truncate<i64>(o.width)) {
                    let v = c.rgb[truncate<usize>((yy * c.width + xx) * 3)];
                    if (v < 128) {
                        dark += 1;
                    } else {
                        light += 1;
                    }
                }
            }
            Check.isTrue(dark > 1000 && light > 1000, "the QR code is drawn at the footer's place")?;
        }
    }
    return Check.isTrue(found, "the group footer has its barcode");
}
