<Project Sdk="Microsoft.NET.Sdk">
  <!-- The reference harness: CosmoReport (the C# being ported) run on the same report files and data as the port,
       writing what the port's tests compare. Not part of the CeeSafe packages. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- The sample invoice's classes, as the server's (FastReport.ZatcaTest). -->
    <Compile Include="../../../../CosmoDesign-fix/CosmoPdf/FastReport/samples/FastReport.ZatcaTest/Models.cs" Link="Models.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../CosmoDesign-fix/CosmoPdf/FastReport/src/FastReport.Core/FastReport.Core.csproj" />
    <!-- The exporters (ImageExport, EscPosExport) and the bridges production installs: the font line counter and the QR
         encoder. -->
    <ProjectReference Include="../../../../CosmoDesign-fix/CosmoPdf/src/CosmoPdf.FastReport/CosmoPdf.FastReport.csproj" />
  </ItemGroup>
</Project>
