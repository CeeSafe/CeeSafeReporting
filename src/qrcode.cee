// SPDX-License-Identifier: MIT
// A QR code encoder, as CosmoPdf's (CosmoPdf.QrCode) encodes: one segment in numeric, alphanumeric or byte mode (the
// text as UTF-8), the smallest version that holds it at the level asked, Reed-Solomon blocks interleaved, and the
// mask with the least penalty. The modules come out the same, so the barcode prints the same.

/// The error correction levels.
public enum QrLevel {
    L,
    M,
    Q,
    H,
}

/// Bit `i` of `v`.
fn bit(v: i64, i: i64) -> bool => ((truncate<u64>(v) >> truncate<u64>(i)) & 1) == 1;

fn levelIndex(l: QrLevel) -> usize => match (l) {
    QrLevel.L => 0,
    QrLevel.M => 1,
    QrLevel.Q => 2,
    QrLevel.H => 3,
};

/// A QR code's modules: `size` rows of `size`, dark true.
public struct QrCode {
    public size: i64;
    public version: i64;
    public mask: i64;
    public modules: Vector<bool>;

    public fn dark(borrow this, row: i64, col: i64) -> bool => this.modules[truncate<usize>(row * this.size + col)];

    /// QrCode.Png(scale)'s pixels: the modules with a quiet zone of four, each `scale` pixels square, black on white
    /// (0xAABBGGRR, for Canvas.compositeImage); and the image's side.
    public fn pixels(borrow this, scale: i64) -> Vector<u32> {
        let s = scale.max(1);
        let side = (this.size + 8) * s;
        var out = Vector<u32>.create();
        for (py in 0..side) {
            for (px in 0..side) {
                let mx = px / s - 4;
                let my = py / s - 4;
                let dark = mx >= 0 && mx < this.size && my >= 0 && my < this.size && this.dark(my, mx);
                let _ = out.push(if (dark) 0xFF000000 else 0xFFFFFFFF);
            }
        }
        return out;
    }
}

// ---- tables ---------------------------------------------------------------------------------------------------------

