// SPDX-License-Identifier: MIT
// The values in a report file's attributes, read as CosmoReport reads them: colours, fonts, border lines and styles,
// alignments (Utils/FrxFormatParser.cs), and FRReader's typed reads of an attribute (Serialization/FRReader.cs),
// .NET's parsing included: Enum.TryParse takes a name in any case, a number, or a list of flag names; float and int
// parse the invariant way. A number that does not parse is the default here, where .NET would throw.

/// A colour (FrColor): red, green, blue and alpha, each 0 to 255.
public struct Color {
    public r: u8;
    public g: u8;
    public b: u8;
    public a: u8;

    public fn rgb(r: u8, g: u8, b: u8) -> Color => Color { r: r, g: g, b: b, a: 255 };
    public fn black() -> Color => Color.rgb(0, 0, 0);
    /// default(FrColor): all zero.
    public fn transparent() -> Color => Color { r: 0, g: 0, b: 0, a: 0 };
    public fn isTransparent(borrow this) -> bool => this.a == 0;
    fn ofRgb(v: u32) -> Color => Color.rgb(truncate<u8>(v >> 16), truncate<u8>(v >> 8), truncate<u8>(v));
}

/// Which sides a border draws (BorderLines), as flags.
public const LINE_LEFT: u32 = 1;
public const LINE_RIGHT: u32 = 2;
public const LINE_TOP: u32 = 4;
public const LINE_BOTTOM: u32 = 8;
public const LINES_ALL: u32 = 15;

/// LineStyle.
public enum LineStyle {
    Solid,
    Dash,
    Dot,
    DashDot,
    DashDotDot,
    Double,
}

const LINE_STYLE_NAMES: [StringView; 6] = ["Solid", "Dash", "Dot", "DashDot", "DashDotDot", "Double"];

fn lineStyleAt(k: i64) -> LineStyle => match (k) {
    1 => LineStyle.Dash,
    2 => LineStyle.Dot,
    3 => LineStyle.DashDot,
    4 => LineStyle.DashDotDot,
    5 => LineStyle.Double,
    _ => LineStyle.Solid,
};

public fn lineStyleName(s: LineStyle) -> StringView => match (s) {
    LineStyle.Solid => "Solid",
    LineStyle.Dash => "Dash",
    LineStyle.Dot => "Dot",
    LineStyle.DashDot => "DashDot",
    LineStyle.DashDotDot => "DashDotDot",
    LineStyle.Double => "Double",
};

/// One side of a border (BorderLine).
public struct BorderLine {
    public color: Color;
    public style: LineStyle;
    public width: f32;

    /// BorderLine.Default: black, solid, 1.
    public fn plain() -> BorderLine => BorderLine { color: Color.black(), style: LineStyle.Solid, width: 1.0 };
}

/// A border (Border): its sides and the line of each.
public struct Border {
    public lines: u32;
    public left: BorderLine;
    public right: BorderLine;
    public top: BorderLine;
    public bottom: BorderLine;
    public shadow: bool;
    public shadowWidth: f32;

    /// Border.None.
    public fn none() -> Border => Border {
        lines: 0,
        left: BorderLine.plain(),
        right: BorderLine.plain(),
        top: BorderLine.plain(),
        bottom: BorderLine.plain(),
        shadow: false,
        shadowWidth: 4.0,
    };

    /// The same line on every side, as the bands' and the page's own readers make it.
    public fn uniform(lines: u32, line: BorderLine) -> Border => Border {
        lines: lines,
        left: line,
        right: line,
        top: line,
        bottom: line,
        shadow: false,
        shadowWidth: 4.0,
    };
}

/// HorzAlign.
public enum HorzAlign {
    Left,
    Center,
    Right,
    Justify,
}

/// VertAlign.
public enum VertAlign {
    Top,
    Center,
    Bottom,
}

/// FrFontSlant.
public enum FontSlant {
    Upright,
    Italic,
    Oblique,
}

/// A font as FrxFormatParser.ParseFont reads "Arial, 12pt, style=Bold": family, size in points, weight, slant.
public struct FontSpec {
    public family: String;
    public size: f32;
    /// 400 normal, 700 bold (FrFontWeight).
    public weight: u32;
    public slant: FontSlant;
}

/// ASCII letters compared without case.
public fn sameIgnoringCase(a: StringView, b: StringView) -> bool {
    let x = a.bytes();
    let y = b.bytes();
    if (x.length != y.length) {
        return false;
    }
    for (k in 0..x.length) {
        let p = if (x[k] >= 'A' && x[k] <= 'Z') x[k] + 32 else x[k];
        let q = if (y[k] >= 'A' && y[k] <= 'Z') y[k] + 32 else y[k];
        if (p != q) {
            return false;
        }
    }
    return true;
}

/// Whether `s` holds `needle`, ASCII letters compared without case.
fn containsIgnoringCase(s: StringView, needle: StringView) -> bool {
    let x = s.bytes();
    let n = needle.bytes();
    if (n.length == 0) {
        return true;
    }
    if (n.length > x.length) {
        return false;
    }
    for (start in 0..x.length - n.length + 1) {
        if (sameIgnoringCase(StringView.fromUtf8(x[start..start + n.length]) ?? "", needle)) {
            return true;
        }
    }
    return false;
}

/// `s` without white space at its ends (.NET's Trim, for ASCII white space).
public fn trimmed(s: StringView) -> StringView {
    let b = s.bytes();
    var start: usize = 0;
    var end = b.length;
    while (start < end && (b[start] == ' ' || b[start] == '\t' || b[start] == '\n' || b[start] == '\r')) {
        start += 1;
    }
    while (end > start && (b[end - 1] == ' ' || b[end - 1] == '\t' || b[end - 1] == '\n' || b[end - 1] == '\r')) {
        end -= 1;
    }
    return StringView.fromUtf8(b[start..end]) ?? "";
}

/// `s` split at each `sep`, as String.Split(sep).
public fn splitOn(s: StringView, sep: u8) -> Vector<StringView> {
    var parts = Vector<StringView>.create();
    let b = s.bytes();
    var start: usize = 0;
    for (k in 0..b.length) {
        if (b[k] == sep) {
            let _ = parts.push(StringView.fromUtf8(b[start..k]) ?? "");
            start = k + 1;
        }
    }
    let _ = parts.push(StringView.fromUtf8(b[start..]) ?? "");
    return parts;
}

/// "Arial, 12pt, style=Bold, Italic" (FrxFormatParser.ParseFont); Arial, 10 points, normal and upright when empty.
public fn parseFont(text: StringView) -> FontSpec {
    var family = String.create();
    if (text.length == 0) {
        let _ = family.append("Arial");
        return FontSpec { family: family, size: 10.0, weight: 400, slant: FontSlant.Upright };
    }
    let parts = splitOn(text, ',');
    let _ = family.append(trimmed(parts[0]));
    var size: f32 = 10.0;
    var weight: u32 = 400;
    var slant = FontSlant.Upright;
    for (i in 1..parts.length) {
        let part = trimmed(parts[i]);
        let b = part.bytes();
        if (b.length >= 2 && sameIgnoringCase(StringView.fromUtf8(b[b.length - 2..]) ?? "", "pt")) {
            match (parseFloat(StringView.fromUtf8(b[0..b.length - 2]) ?? "")) {
                Some(s) => { size = s; }
                null => {}
            }
        } else if (b.length >= 6 && sameIgnoringCase(StringView.fromUtf8(b[0..6]) ?? "", "style=")) {
            if (containsIgnoringCase(part, "Bold")) {
                weight = 700;
            }
        } else if (sameIgnoringCase(part, "Bold")) {
            weight = 700;
        } else if (sameIgnoringCase(part, "Italic")) {
            slant = FontSlant.Italic;
        }
    }
    if (containsIgnoringCase(text, "Italic")) {
        slant = FontSlant.Italic;
    }
    return FontSpec { family: family, size: size, weight: weight, slant: slant };
}

