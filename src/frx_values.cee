/// "231, 194, 98", "128, 231, 194, 98" (alpha first) or a name (FrxFormatParser.ParseColor); `otherwise` when it is
/// none of them.
public fn parseColor(text: StringView, otherwise: Color) -> Color {
    if (text.length == 0) {
        return otherwise;
    }
    let s = trimmed(text);
    for (k in 0..57usize) {
        if (sameIgnoringCase(s, OWN_COLOR_NAMES[k])) {
            return if (k == 8) Color.transparent() else Color.ofRgb(OWN_COLOR_VALUES[k]);
        }
    }
    let parts = splitOn(s, ',');
    if (parts.length == 3 || parts.length == 4) {
        var v = [0u8; 4];
        var ok = true;
        for (k in 0..parts.length) {
            match (parseByte(trimmed(parts[k]))) {
                Some(x) => { v[k] = x; }
                null => { ok = false; }
            }
        }
        if (ok) {
            return if (parts.length == 3) Color.rgb(v[0], v[1], v[2]) else Color { r: v[1], g: v[2], b: v[3], a: v[0] };
        }
    }
    // .NET's named colours (System.Drawing.Color.FromName).
    for (k in 0..WEB_COLOR_COUNT) {
        if (sameIgnoringCase(s, WEB_COLOR_NAMES[k])) {
            return Color.ofRgb(WEB_COLOR_VALUES[k]);
        }
    }
    return otherwise;
}

/// "Left, Top" or "All" (FrxFormatParser.ParseBorderLines): names it does not know add nothing.
public fn parseBorderLines(text: StringView) -> u32 {
    var lines: u32 = 0;
    if (text.length == 0) {
        return lines;
    }
    for (part in splitOn(text, ',').view()) {
        let p = trimmed(part);
        lines = lines | (if (p == "All") LINES_ALL else if (p == "Left") LINE_LEFT else if (p == "Right") LINE_RIGHT
            else if (p == "Top") LINE_TOP else if (p == "Bottom") LINE_BOTTOM else 0);
    }
    return lines;
}

public fn parseHorzAlign(text: StringView) -> HorzAlign =>
    if (text == "Center") HorzAlign.Center else if (text == "Right") HorzAlign.Right
        else if (text == "Justify") HorzAlign.Justify else HorzAlign.Left;

public fn parseVertAlign(text: StringView) -> VertAlign =>
    if (text == "Center") VertAlign.Center else if (text == "Bottom") VertAlign.Bottom else VertAlign.Top;

/// A float the invariant way (float.Parse): white space at its ends allowed.
public fn parseFloat(text: StringView) -> f32? => NumberParsing.parseF32(trimmed(text).bytes());

/// An int the invariant way (int.Parse): white space at its ends and a sign allowed.
public fn parseInt(text: StringView) -> i64? {
    let t = trimmed(text).bytes();
    if (t.length > 0 && t[0] == '+') {
        return NumberParsing.parseI64(t[1..]);
    }
    return NumberParsing.parseI64(t);
}

/// A byte (byte.Parse): 0 to 255, white space at its ends allowed.
fn parseByte(text: StringView) -> u8? {
    let t = trimmed(text).bytes();
    return NumberParsing.parseU8(if (t.length > 0 && t[0] == '+') t[1..] else t);
}

/// What .NET's Enum.TryParse gives for `text` against the enum whose members are `names` with the values `values`:
/// a member's name (in any case when `ignoreCase`), a number (any, defined or not), or, for a flags enum, names
/// separated by commas, their values or-ed. Null when it is none of them.
public fn parseEnum(text: StringView, names: Slice<StringView>, values: Slice<i64>, ignoreCase: bool) -> i64? {
    let t = trimmed(text);
    if (t.length == 0) {
        return null;
    }
    let first = t.bytes()[0];
    if ((first >= '0' && first <= '9') || first == '-' || first == '+') {
        return parseInt(t);
    }
    var result: i64 = 0;
    for (part in splitOn(t, ',').view()) {
        let p = trimmed(part);
        var found = false;
        for (k in 0..names.length) {
            if (if (ignoreCase) sameIgnoringCase(p, names[k]) else p == names[k]) {
                result = truncate<i64>(truncate<u64>(result) | truncate<u64>(values[k]));
                found = true;
                break;
            }
        }
        if (!found) {
            return null;
        }
    }
    return result;
}

/// LineStyle by Enum.TryParse (exact case), or `otherwise`.
public fn parseLineStyle(text: StringView, otherwise: LineStyle) -> LineStyle {
    let values: [i64; 6] = [0, 1, 2, 3, 4, 5];
    return match (parseEnum(text, LINE_STYLE_NAMES[..], values[..], false)) {
        Some(k) => lineStyleAt(k),
        null => otherwise,
    };
}

/// PrintOn's flags: first page, last page, odd pages, even pages, a repeated band, a single page.
public const PRINT_ON_ALL: u32 = 63;
const PRINT_ON_NAMES: [StringView; 6] = ["FirstPage", "LastPage", "OddPages", "EvenPages", "RepeatedBand", "SinglePage"];

/// FRReader's typed reads of an element's attributes. An empty or missing attribute is the default.
public struct Attrs<region r> {
    node: borrow(r) XmlNode;

    public fn of(node: borrow(r) XmlNode) -> Attrs<r> => Attrs { node: node };

    public fn has(borrow this, name: StringView) -> bool => this.node.has(name);

    /// ReadStr.
    public fn str(borrow this, name: StringView) -> StringView => this.node.attr(name);

    public fn string(borrow this, name: StringView, otherwise: StringView) -> String {
        var s = String.create();
        let v = this.node.attr(name);
        let _ = s.append(if (v.length == 0) otherwise else v);
        return s;
    }

    /// ReadInt.
    public fn int(borrow this, name: StringView, otherwise: i64) -> i64 {
        let v = this.node.attr(name);
        return if (v.length == 0) otherwise else parseInt(v) ?? otherwise;
    }

    /// ReadFloat.
    public fn float(borrow this, name: StringView, otherwise: f32) -> f32 {
        let v = this.node.attr(name);
        return if (v.length == 0) otherwise else parseFloat(v) ?? otherwise;
    }

    /// ReadBool: "true" only is true.
    public fn bool(borrow this, name: StringView, otherwise: bool) -> bool {
        let v = this.node.attr(name);
        return if (v.length == 0) otherwise else v == "true";
    }

    /// ReadColor: "R,G,B" or "A,R,G,B" numbers only.
    public fn color(borrow this, name: StringView, otherwise: Color) -> Color {
        let v = this.node.attr(name);
        if (v.length == 0) {
            return otherwise;
        }
        let parts = splitOn(v, ',');
        if (parts.length != 3 && parts.length != 4) {
            return otherwise;
        }
        var x = [0u8; 4];
        for (k in 0..parts.length) {
            match (parseByte(parts[k])) {
                Some(b) => { x[k] = b; }
                null => { return otherwise; }
            }
        }
        return if (parts.length == 3) Color.rgb(x[0], x[1], x[2]) else Color { r: x[1], g: x[2], b: x[3], a: x[0] };
    }

    /// ReadEnum (ignoring case) against `names`, whose values are their places.
    public fn choice(borrow this, name: StringView, names: Slice<StringView>, otherwise: i64) -> i64 {
        var values = Vector<i64>.create();
        for (k in 0..names.length) {
            let _ = values.push(truncate<i64>(k));
        }
        return parseEnum(this.node.attr(name), names, values.view(), true) ?? otherwise;
    }

    /// ReadEnum of PrintOn, its default every page.
    public fn printOn(borrow this) -> u32 {
        let values: [i64; 6] = [1, 2, 4, 8, 16, 32];
        return match (parseEnum(this.node.attr("PrintOn"), PRINT_ON_NAMES[..], values[..], true)) {
            Some(v) => truncate<u32>(v),
            null => PRINT_ON_ALL,
        };
    }
}
